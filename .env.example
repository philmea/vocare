# Copy to .env and fill in. Only the providers whose keys are set will appear in the app.
# Microsoft Edge voices are always available (free, no key).

# Protect the app if it's reachable from the internet (strongly recommended when an API key is set).
APP_PASSWORD=

# OpenAI TTS (good quality, ~ $0.015 per minute of audio with gpt-4o-mini-tts)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_INSTRUCTIONS=You are narrating a fantasy audiobook...

# ElevenLabs (best quality, most expensive). Voices as "Name:voice_id,Name:voice_id"
ELEVENLABS_API_KEY=
ELEVENLABS_VOICES=George:JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# Where scraped text and MP3s are cached
DATA_DIR=data
MAX_CONCURRENT_JOBS=2
